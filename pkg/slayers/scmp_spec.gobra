// +gobra

package slayers

import (
	"github.com/google/gopacket"

	. "github.com/scionproto/scion/verification/utils/definitions"
	"github.com/scionproto/scion/verification/utils/slices"
)

// ChecksumNetworkLayerMem holds the resources of the private state of an SCMP
// layer, namely the SCION header that the layer uses to compute its checksum.
// The predicate is closed because its body mentions a non-exported field;
// importing packages may hold it, but they can neither fold nor unfold it.
// TODO(gobra#1092): closed
pred (s *SCMP) ChecksumNetworkLayerMem() {
	acc(&s.scn) &&
	(s.scn != nil ==> s.scn.ChecksumMem())
}

pred (s *SCMP) NonInitMem() {
	acc(&s.TypeCode) &&
	acc(&s.Checksum) &&
	acc(&s.BaseLayer) &&
	s.ChecksumNetworkLayerMem()
}

pred (s *SCMP) Mem(ub []byte) {
	acc(&s.TypeCode) &&
	acc(&s.Checksum) &&
	s.BaseLayer.Mem(ub, 4) &&
	s.ChecksumNetworkLayerMem()
}

// EstablishNonInitMem packages full permission to a zero-valued SCMP layer into
// its NonInitMem predicate. Importing packages cannot fold NonInitMem
// themselves, since it covers the private state of the layer.
ghost
requires acc(s)
requires *s === SCMP{}
ensures  s.NonInitMem()
decreases
func (s *SCMP) EstablishNonInitMem() {
	fold s.ChecksumNetworkLayerMem()
	fold s.NonInitMem()
}

ghost
requires s.Mem(ub)
ensures  s.NonInitMem()
decreases
func (s *SCMP) DowngradePerm(ghost ub []byte) {
	unfold s.Mem(ub)
	unfold s.BaseLayer.Mem(ub, 4)
	fold s.NonInitMem()
}

requires false
func (b *SCMP) LayerContents() (res []byte) {
	res = b.BaseLayer.LayerContents()
	return res
}

preserves acc(b.Mem(ub), R20)
ensures   0 <= start && start <= end && end <= len(ub)
ensures   len(res) == end - start
ensures   res === ub[start:end]
decreases
func (b *SCMP) LayerPayload(ghost ub []byte) (res []byte, ghost start int, ghost end int) {
	unfold acc(b.Mem(ub), R20)
	res = b.BaseLayer.LayerPayload(ub, 4)
	start = 4
	end = len(ub)
	fold acc(b.Mem(ub), R20)
	return res, start, end
}

(*SCMP) implements gopacket.Layer
(*SCMP) implements gopacket.SerializableLayer
(*SCMP) implements gopacket.DecodingLayer
