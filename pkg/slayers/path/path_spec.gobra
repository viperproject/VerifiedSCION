// +gobra

package path

import "github.com/scionproto/scion/verification/utils/slices"

/** rawPath spec **/
pred (r *rawPath) Mem() {
	acc(r) && slices.AbsSlice_Bytes(r.raw, 0, len(r.raw))
}

pred (r *rawPath) NonInitMem() {
	acc(r)
}

(*rawPath) implements Path

ghost
requires p.Mem()
ensures  p.NonInitMem()
decreases
func (p *rawPath) DowngradePerm() {
	unfold p.Mem()
	fold p.NonInitMem()
}
/** End of rawPath spec **/

/** Global state of the pacakge **/
ghost const MaxPathType = maxPathType

// (VerifiedSCION) initEnsures is deprecated in current Gobra, which was the only
// mechanism establishing registeredPaths/strictDecoding as addressable/permission-
// tracked starting at package init. Without it, this predicate can no longer hold
// real content (see path.go for the corresponding trusted/commented-out init code).
// Original body:
// acc(&registeredPaths) &&
// acc(&strictDecoding) &&
// forall t Type :: (0 <= t && t < maxPathType && registeredPaths[t].inUse) ==> registeredPaths[t].Metadata.New implements NewPathSpec
pred PathPackageMem() {
	true
}

ghost
requires 0 <= t && t < maxPathType
requires acc(PathPackageMem(), _)
pure func Registered(t Type) (res bool)

ghost
requires 0 <= t && t < maxPathType
requires acc(PathPackageMem(), _)
pure func GetType(t Type) (res Metadata)

ghost
requires acc(PathPackageMem(), _)
pure func IsStrictDecoding() (b bool)

// without passing `writePerm` explicitely below, we run into
// exceptions when verifying method RegisterPath in package 'empty'
ensures acc(p.NonInitMem(), writePerm)
decreases
func NewPathSpec() (p Path)

/** End of global state of the pacakge **/