requires  0 <= offset
requires  0 <= currHfIdx && currHfIdx <= end
requires  end <= segLen
requires  offset + path.HopLen * segLen <= len(raw)
ensures   hopFields(raw, offset, currHfIdx, segLen)[:end - currHfIdx] ==
	hopFields(raw, offset, currHfIdx, end)
decreases end - currHfIdx
func HopsFromSuffixOfRawMatchSuffixOfHops(raw seq[byte], offset int, currHfIdx int, segLen int, end int) {
	if (currHfIdx != end) {
		HopsFromSuffixOfRawMatchSuffixOfHops(raw, offset, currHfIdx + 1, segLen, end)
	}
}

ghost
requires  0 <= offset
requires  0 <= start
requires  0 <= currHfIdx && currHfIdx <= segLen - start
requires  offset + path.HopLen * segLen <= len(raw)
ensures   hopFields(raw, offset, currHfIdx, segLen)[start:] ==
 	hopFields(raw, offset, currHfIdx + start, segLen)
decreases start
func HopsFromPrefixOfRawMatchPrefixOfHops(raw seq[byte], offset int, currHfIdx int, segLen int, start int) {
	if (start != 0) {
		HopsFromPrefixOfRawMatchPrefixOfHops(raw, offset, currHfIdx, segLen, start - 1)
	}
}

ghost
requires  0 <= offset
requires  0 <= start && start <= currHfIdx
requires  0 <= currHfIdx && currHfIdx <= segLen
requires  offset + path.HopLen * segLen <= len(raw)
ensures   hopFields(raw, offset, currHfIdx, segLen) ==
 	hopFields(raw, offset + start * path.HopLen, currHfIdx - start, segLen - start)
decreases segLen - currHfIdx
func AlignHopsOfRawWithOffsetAndIndex(raw seq[byte], offset int, currHfIdx int, segLen int, start int) {
	if (currHfIdx != segLen) {
		AlignHopsOfRawWithOffsetAndIndex(raw, offset, currHfIdx + 1, segLen, start)
	}
}
