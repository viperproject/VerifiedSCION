decreases
func XoverLeftSeg(raw seq[byte], currInfIdx int, segs io.SegLens) {
	leftseg := reveal LeftSeg(raw, currInfIdx, segs, 0)
	midseg := reveal MidSeg(raw, currInfIdx, segs, 0)
