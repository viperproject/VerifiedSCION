// +gobra

// This package contains some lemmas that are useful to deal with bitwise
// operations in a scalable way.
//
// These lemmas used to be axioms here, proven separately in Dafny (in a file
// './proofs.dfy' that no longer exists), because Gobra could not reason about the
// values of bitwise operations. It now can: this package is verified with
// '--interpretBitwise' (see './gobra.json'), which gives the bitwise and shift
// operations bodies defined over SMT bitvectors. The lemmas below therefore carry
// bodies and are proven by Gobra itself.
//
// The rest of the repository is deliberately verified *without* that flag, since
// bitvector reasoning is substantially more expensive. Client packages see only the
// signatures below, whose postconditions relate the abstract (uninterpreted) bitwise
// terms they do produce. Extend this file rather than reasoning about bit patterns
// at the client side.

package bitwise

ghost
ensures 0 <= b && integer(b) < 256
decreases
func ByteValue(b byte) {}

// BitAnd3 is stated over `int` because that is the width at which the operation it
// describes happens: slayers.AddrType.Length computes `int(tl) & 0x3`, and under bounded
// integer semantics a fact about the byte-kind conjunction would not apply to the int-kind
// one. It has to stay pure, since it appears in the postcondition of that pure function,
// and therefore bodyless: a body travels to every importing package, which would then have
// to re-prove it without interpreted bitwise. BitAnd3Lemma below discharges the same facts.
ghost
ensures 0 <= b & 0x3 && b & 0x3 <= 3
ensures b == 0 ==> res == 0
ensures b == 3 ==> res == 3
ensures b == 4 ==> res == 0
ensures res == b & 0x3
decreases
pure func BitAnd3(b int) (res int)

// Discharges, in Gobra, exactly what the BitAnd3 axiom above assumes. This is the most
// expensive lemma in the package by a wide margin: its operand is 64 bits wide.
ghost
ensures 0 <= b & 0x3 && b & 0x3 <= 3
ensures b == 0 ==> b & 0x3 == 0
ensures b == 3 ==> b & 0x3 == 3
ensures b == 4 ==> b & 0x3 == 0
decreases
func BitAnd3Lemma(b int) {}

// byte-typed so the lemma's bitwise terms match the byte-kind operations that
// real parsing code produces (bounded semantics gives each kind its own helpers)
ghost
ensures 0 <= b & 0x7 && b & 0x7 <= 7
decreases
func BitAnd7(b byte) {}

ghost
ensures 0 <= b >> 30 && b >> 30 <= 3
decreases
func Shift30LessThan4(b uint32) {}

ghost
ensures 0 <= b & 0x3F && b & 0x3F < 64
decreases
func And3fAtMost64(b uint8) {}

ghost
// Under bounded integer semantics, facts about *constant* bitwise expressions are
// constant-folded away and never connect to the abstract bitwise helper terms that
// runtime operations produce. The lemmas are therefore stated as quantified facts
// over byte-typed operands, with triggers on the bitwise terms themselves.
ensures forall b byte :: { b | 1 } (b | 1) & 1 == 1
ensures forall b byte :: { b | 2 } (b | 2) & 2 == 2
ensures forall b byte :: { b | 1 } (b | 1) & 2 == b & 2
ensures forall b byte :: { b | 2 } (b | 2) & 1 == b & 1
ensures forall b byte :: { b | 1 } b & 2 == 0 ==> b | 1 == (b & 1 == 1 ? b : b + 1)
ensures forall b byte :: { b & 1 } b == 0 ==> b & 1 == 0
ensures forall b byte :: { b & 2 } b == 0 ==> b & 2 == 0
decreases
func InfoFieldFirstByteSerializationLemmas() {}

ghost
ensures csum > 0xffff ==>
	let newCsum := (csum >> 16) + (csum & 0xffff) in
	newCsum < csum
decreases
func FoldChecksumLemma(csum uint32) {}

/**** Functional specs for encoding/binary (BigEndian) ****/

ghost
decreases
pure func FUint16Spec(b0, b1 byte) uint16 {
	return uint16(b1) | (uint16(b0) << 8)
}

ghost
decreases
pure func FPutUint16Spec0(v uint16) byte {
	return byte(v >> 8)
}

ghost
decreases
pure func FPutUint16Spec1(v uint16) byte {
	return byte(v & 0xFF)
}

// Serializing a uint16 and reading it back yields the original value.
ghost
ensures FUint16Spec(FPutUint16Spec0(v), FPutUint16Spec1(v)) == v
decreases
func FUint16AfterFPutUint16(v uint16) {}

// Reading a uint16 out of two bytes and serializing it back yields the original bytes.
ghost
ensures FPutUint16Spec0(FUint16Spec(b0, b1)) == b0
ensures FPutUint16Spec1(FUint16Spec(b0, b1)) == b1
decreases
func FPutUint16AfterFUint16(b0, b1 byte) {}

ghost
decreases
pure func FUint32Spec(b0, b1, b2, b3 byte) uint32 {
	return uint32(b3) | (uint32(b2) << 8) | (uint32(b1) << 16) | (uint32(b0) << 24)
}

ghost
decreases
pure func FPutUint32Spec0(v uint32) byte {
	return byte((v >> 24) & 0xFF)
}

ghost
decreases
pure func FPutUint32Spec1(v uint32) byte {
	return byte((v >> 16) & 0xFF)
}

ghost
decreases
pure func FPutUint32Spec2(v uint32) byte {
	return byte((v >> 8) & 0xFF)
}

ghost
decreases
pure func FPutUint32Spec3(v uint32) byte {
	return byte(v & 0xFF)
}

// Serializing a uint32 and reading it back yields the original value.
ghost
ensures FUint32Spec(FPutUint32Spec0(v), FPutUint32Spec1(v), FPutUint32Spec2(v), FPutUint32Spec3(v)) == v
decreases
func FUint32AfterFPutUint32(v uint32) {}

/**** Bridging bitwise operations and arithmetic ****/

// The solver copes badly with several independent bytes interacting inside one 32-bit word,
// which is what a byte-wise round trip asks of it. The lemmas in this section each do one
// small piece of bitvector reasoning in isolation; with them, the packing and unpacking of a
// word become plain arithmetic on multiples of powers of two, which is cheap.

// A shift left is a multiplication, as long as the bits shifted out are zero.
ghost
requires x < (1 << 8)
ensures  x << 24 == x * (1 << 24)
decreases
func ShiftLeft24IsMul(x uint32) {}

ghost
requires x < (1 << 16)
ensures  x << 16 == x * (1 << 16)
decreases
func ShiftLeft16IsMul(x uint32) {}

ghost
requires x < (1 << 24)
ensures  x << 8 == x * (1 << 8)
decreases
func ShiftLeft8IsMul(x uint32) {}

// A shift right is a division.
ghost
ensures v >> 24 == v / (1 << 24)
decreases
func ShiftRight24IsDiv(v uint32) {}

ghost
ensures v >> 16 == v / (1 << 16)
decreases
func ShiftRight16IsDiv(v uint32) {}

ghost
ensures v >> 8 == v / (1 << 8)
decreases
func ShiftRight8IsDiv(v uint32) {}

// Narrowing to a byte is a remainder.
ghost
ensures uint32(byte(v & 0xFF)) == v % (1 << 8)
decreases
func ByteIsMod(v uint32) {}

// When the operands occupy disjoint bit ranges, a disjunction is a sum.
ghost
requires x % (1 << 8) == 0 && y < (1 << 8)
ensures  x | y == x + y
ensures  y | x == x + y
decreases
func OrIsPlus8(x, y uint32) {}

ghost
requires x % (1 << 16) == 0 && y < (1 << 16)
ensures  x | y == x + y
ensures  y | x == x + y
decreases
func OrIsPlus16(x, y uint32) {}

ghost
requires x % (1 << 24) == 0 && y < (1 << 24)
ensures  x | y == x + y
ensures  y | x == x + y
decreases
func OrIsPlus24(x, y uint32) {}

// The packed word, written arithmetically.
ghost
ensures FUint32Spec(b0, b1, b2, b3) ==
	uint32(b0) * (1 << 24) + uint32(b1) * (1 << 16) + uint32(b2) * (1 << 8) + uint32(b3)
decreases
func FUint32SpecIsSum(b0, b1, b2, b3 byte) {
	ShiftLeft8IsMul(uint32(b2))
	ShiftLeft16IsMul(uint32(b1))
	ShiftLeft24IsMul(uint32(b0))
	OrIsPlus8(uint32(b2) << 8, uint32(b3))
	OrIsPlus16(uint32(b1) << 16, uint32(b3) | uint32(b2) << 8)
	OrIsPlus24(uint32(b0) << 24, uint32(b3) | uint32(b2) << 8 | uint32(b1) << 16)
}

// Reading a uint32 out of four bytes and serializing it back yields the original bytes.
ghost
ensures FPutUint32Spec0(FUint32Spec(b0, b1, b2, b3)) == b0
ensures FPutUint32Spec1(FUint32Spec(b0, b1, b2, b3)) == b1
ensures FPutUint32Spec2(FUint32Spec(b0, b1, b2, b3)) == b2
ensures FPutUint32Spec3(FUint32Spec(b0, b1, b2, b3)) == b3
decreases
func FPutUint32AfterFUint32(b0, b1, b2, b3 byte) {
	// with the word written as a sum, extracting a byte is a division and a remainder
	FUint32SpecIsSum(b0, b1, b2, b3)
	v := FUint32Spec(b0, b1, b2, b3)
	ShiftRight24IsDiv(v)
	ShiftRight16IsDiv(v)
	ShiftRight8IsDiv(v)
	ByteIsMod(v >> 24)
	ByteIsMod(v >> 16)
	ByteIsMod(v >> 8)
	ByteIsMod(v)
}

/**** Serialization of the SCION path meta header ****/

// The five fields of the path meta header, as they are packed into a single 32-bit line.
type MetaHdr struct {
	CurrINF byte
	CurrHF  byte
	SegLen0 byte
	SegLen1 byte
	SegLen2 byte
}

// Every field of a meta header fits in the number of bits reserved for it on the wire.
// Each conjunct is essential for proving SerializeAndDeserializeMetaHdrLemma.
ghost
decreases
pure func InBounds(m MetaHdr) bool {
	return m.CurrINF <= 3 &&
		m.CurrHF <= 63 &&
		m.SegLen0 <= 63 &&
		m.SegLen1 <= 63 &&
		m.SegLen2 <= 63
}

ghost
decreases
pure func SerializedToLine(m MetaHdr) uint32 {
	return (uint32(m.CurrINF) << 30) |
		(uint32(m.CurrHF & 0x3F) << 24) |
		(uint32(m.SegLen0 & 0x3F) << 12) |
		(uint32(m.SegLen1 & 0x3F) << 6) |
		uint32(m.SegLen2 & 0x3F)
}

ghost
decreases
pure func DecodedFrom(line uint32) MetaHdr {
	// Each field is narrowed to a byte *before* it is masked, exactly as the real decoder
	// in scion.MetaHdr.DecodeFromBytes does. That keeps the masks at byte width, where the
	// bitwise operations are far cheaper to interpret, and makes the terms here the same
	// ones the decoding code produces -- under bounded-integer semantics each kind has its
	// own bitwise helpers, so a fact about a uint32 mask would not apply to a byte one.
	return MetaHdr{
		CurrINF: byte(line >> 30),
		CurrHF:  byte((line >> 24) & 0x3F),
		SegLen0: byte((line >> 12) & 0x3F),
		SegLen1: byte((line >> 6) & 0x3F),
		SegLen2: byte(line & 0x3F),
	}
}

// Packing a meta header into a line and decoding it back yields the original header.
ghost
requires InBounds(m)
ensures  DecodedFrom(SerializedToLine(m)) == m
decreases
func SerializeAndDeserializeMetaHdrLemma(m MetaHdr) {}

// The same round trip, but going through the four bytes that the line is serialized to.
ghost
requires InBounds(m)
requires let line := SerializedToLine(m) in
	b0 == FPutUint32Spec0(line) &&
	b1 == FPutUint32Spec1(line) &&
	b2 == FPutUint32Spec2(line) &&
	b3 == FPutUint32Spec3(line)
ensures  DecodedFrom(FUint32Spec(b0, b1, b2, b3)) == m
decreases
func SerializeAndDeserializeLemma(m MetaHdr, b0, b1, b2, b3 byte) {
	// the bytes reconstruct the line, which in turn decodes back to `m`
	FUint32AfterFPutUint32(SerializedToLine(m))
	SerializeAndDeserializeMetaHdrLemma(m)
}